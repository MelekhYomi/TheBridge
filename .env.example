# Copy this file to .env and fill in the values.

PORT=3000
# Public URL of the site, used for payment redirect links (no trailing slash).
BASE_URL=http://localhost:3000
# Set to "production" on the live server (turns on secure cookies, disables demo payments).
NODE_ENV=development

# Admin login for /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-password
# Long random string used to sign admin sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Paystack — dashboard.paystack.com > Settings > API Keys & Webhooks
# Webhook URL to set there: {BASE_URL}/webhooks/paystack
PAYSTACK_SECRET_KEY=

# Flutterwave — dashboard.flutterwave.com > Settings > API Keys / Webhooks
# Webhook URL to set there: {BASE_URL}/webhooks/flutterwave
# FLW_SECRET_HASH is the "secret hash" you type in the webhook settings.
FLW_SECRET_KEY=
FLW_SECRET_HASH=

# Local testing only: "1" shows a fake checkout when no keys are set.
# Ignored when NODE_ENV=production.
PAYMENT_DEMO=0

# Google Sheet storage (Bridge Database). Everything the site saves goes here:
# sign-ups, payments, messages, content, courses, facilitators and media.
# See scripts/bridge-sheet.gs for setup. SHEET_API_KEY must match the script's
# API_KEY property. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Leave both empty in development to use a local file (data/store.json).
SHEET_API_URL=
SHEET_API_KEY=
